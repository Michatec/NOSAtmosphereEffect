<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fine_tuning"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="32dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutPollInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/unlock_check_interval_ms"
                app:helperText="@string/unlock_helper_text"
                app:helperTextTextColor="@color/white_alpha_70"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_info"
                app:endIconTint="@color/brand_primary"
                app:endIconContentDescription="@string/more_info"
                android:layout_marginBottom="24dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPollInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutLockDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/lock_delay_ms"
                app:helperText="@string/lock_helper_text"
                app:helperTextTextColor="@color/white_alpha_70"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_info"
                app:endIconTint="@color/brand_primary"
                app:endIconContentDescription="@string/more_info"
                android:layout_marginBottom="24dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputLockDelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/animation_duration_ms"
                app:helperText="@string/animation_duration_helper_text"
                app:helperTextTextColor="@color/white_alpha_70"
                android:layout_marginBottom="32dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputAnimDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/white"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRotationContainer"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/playlist_rotation_mode"
                app:helperText="@string/playlist_rotation_helper"
                app:helperTextTextColor="@color/white_alpha_70"
                android:layout_marginBottom="24dp">

                <AutoCompleteTextView
                    android:id="@+id/dropdownRotation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:popupBackground="@color/black"
                    android:textColor="@color/white"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/halftoneSettingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/halftone_pixel_size"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderDotSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="40.0"
                    android:value="12.0"
                    android:stepSize="1.0" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchGrayscale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bw_effect"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/colorFillSettingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fingerprint_horizontal"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderOriginX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:value="0.5"
                    android:stepSize="0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fingerprint_vertical"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderOriginY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:value="0.8"
                    android:stepSize="0.01"
                    android:layout_marginBottom="24dp"/>
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNoise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_noise"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:layout_marginBottom="32dp"
                app:thumbTint="@color/brand_primary"
                app:trackTint="@color/brand_on_primary"/>

            <LinearLayout
                android:id="@+id/layoutNoiseSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/noise_scale"
                    app:helperText="@string/noise_scale_helper"
                    app:helperTextTextColor="@color/white_alpha_70"
                    android:layout_marginBottom="24dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNoiseScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/white"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/noise_strength"
                    app:helperText="@string/noise_strength_helper"
                    app:helperTextTextColor="@color/white_alpha_70"
                    android:layout_marginBottom="32dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNoiseStrength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/white"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/blobColorSettingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blob_saturation"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSaturation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="3.0"
                    android:value="1.0"
                    android:stepSize="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blob_contrast"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderContrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="3.0"
                    android:value="1.0"
                    android:stepSize="0.1"
                    android:layout_marginBottom="24dp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/save_apply"
                android:layout_marginBottom="16dp"
                app:cornerRadius="28dp"
                android:backgroundTint="@color/brand_primary"
                android:textColor="@color/brand_on_primary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetDefaults"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/reset_recommended"
                app:cornerRadius="28dp"
                android:textColor="@color/white"
                app:strokeColor="@color/white_alpha_70"/>

        </LinearLayout>
    </ScrollView>
</FrameLayout>